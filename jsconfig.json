{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.js", "server/**/*.js", "types/**/*.d.ts", "scripts/**/*.mjs", "tests/**/*.mjs", "tests/**/*.js", "bin/**/*.js", "playwright.config.mjs", "playwright.smoke.config.mjs"]
}
